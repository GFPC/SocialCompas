# MAX Messenger Bot Configuration
MAX_BOT_TOKEN=YOUR_MAX_BOT_TOKEN_HERE
# Public bot username (informational)
MAX_BOT_USERNAME=
# TLS for the MAX API: Russian Trusted Root CA is shipped in certs/ (public certificate, not a secret)
MAX_CA_BUNDLE=certs/russian_trusted_root_ca.pem
MAX_TLS_INSECURE=false
MAX_API_URL=https://platform-api2.max.ru
SIMULATION_MODE=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
WEBHOOK_URL=https://api.socialcompass.ru/webhook

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# MySQL Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=bot_user
# dev default for the local compose stack; change for any real deployment
MYSQL_PASSWORD=bot_password
MYSQL_DB=socialcompas_db

# AI Tunnel Configuration
AITUNNEL_API_KEY=YOUR_AITUNNEL_API_KEY_HERE
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AI_MODEL=gpt-4o-mini
CHAT_RATE_LIMIT_PER_MINUTE=10


# MiniApp build args (docker compose build --build-arg ...); leave empty for same-origin API
# VITE_API_URL=
# VITE_YMAPS_KEY=
