# MAX Messenger Bot Configuration

# Bot API Token from @MasterBot or business.max.ru
MAX_BOT_TOKEN=your_max_bot_token_here

# API Base URL (Current MAX API v2 endpoint)
MAX_API_URL=https://platform-api2.max.ru

# Execution Mode: true for local simulator, false for live MAX server
SIMULATION_MODE=true

# Server configuration (Webhook / Simulator mode)
HOST=0.0.0.0
PORT=8000
WEBHOOK_URL=
